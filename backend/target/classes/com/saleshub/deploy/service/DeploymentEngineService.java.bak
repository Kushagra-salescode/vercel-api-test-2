package com.saleshub.deploy.service;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.saleshub.deploy.domain.DeploymentEntity;
import com.saleshub.deploy.domain.ProjectEntity;
import io.quarkus.logging.Log;
import jakarta.enterprise.context.ApplicationScoped;
import jakarta.inject.Inject;
import org.eclipse.microprofile.config.inject.ConfigProperty;

import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.nio.charset.StandardCharsets;
import java.time.OffsetDateTime;
import java.util.HashMap;
import java.util.Map;

@ApplicationScoped
public class DeploymentEngineService {

    @ConfigProperty(name = "vercel.api.base-url")
    String vercelBaseUrl;

    @ConfigProperty(name = "vercel.api.token")
    String vercelApiToken;

    @ConfigProperty(name = "vercel.team.id")
    String vercelTeamId;

    @Inject
    ObjectMapper objectMapper;

    @Inject
    IdGenerator idGenerator;

    @Inject
    ClockProvider clock;

    private final HttpClient httpClient = HttpClient.newHttpClient();

    public DeploymentEntity triggerGitHubDeployment(ProjectEntity project, String commitHash, String branch) {
        DeploymentEntity deployment = new DeploymentEntity();
        deployment.id = idGenerator.newId();
        deployment.projectId = project.id;
        deployment.sourceType = project.sourceType;
        deployment.triggerType = DeploymentEntity.TriggerType.GITHUB_PUSH;
        deployment.commitHash = commitHash;
        deployment.branch = branch;
        deployment.status = DeploymentEntity.Status.QUEUED;
        deployment.createdAt = clock.nowUtc();
        deployment.updatedAt = deployment.createdAt;

        try {
            Map<String, Object> payload = new HashMap<>();
            payload.put("name", project.slug);
            payload.put("gitSource", new HashMap<String, String>() {{
                put("type", "github");
                put("repo", project.githubOwner + "/" + project.githubRepo);
                if (project.githubRepoId != null) {
                    put("repoId", project.githubRepoId);
                }
                put("ref", branch);
                if (commitHash != null) {
                    put("sha", commitHash);
                }
            }});
            if (project.outputDirectory != null) {
                payload.put("outputDirectory", project.outputDirectory);
            }
            if (project.buildCommand != null) {
                payload.put("buildCommand", project.buildCommand);
            }

            String jsonBody = objectMapper.writeValueAsString(payload);
            
            System.out.println("Triggering Vercel deployment for " + project.slug);

            HttpRequest request = HttpRequest.newBuilder()
                    .uri(URI.create(vercelBaseUrl + "/v13/deployments"))
                    .header("Authorization", "Bearer " + vercelApiToken)
                    .header("Content-Type", "application/json")
                    .POST(HttpRequest.BodyPublishers.ofString(jsonBody, StandardCharsets.UTF_8))
                    .build();

            HttpResponse<String> response = httpClient.send(request, HttpResponse.BodyHandlers.ofString());
            System.out.println("Vercel response: " + response.statusCode() + " " + response.body());
            
            if (response.statusCode() >= 200 && response.statusCode() < 300) {
                JsonNode json = objectMapper.readTree(response.body());
                deployment.vercelDeploymentId = json.get("id").asText();
                deployment.url = json.get("url").asText();
                deployment.status = DeploymentEntity.Status.RUNNING;
                deployment.updatedAt = clock.nowUtc();
            } else {
                deployment.status = DeploymentEntity.Status.FAILED;
                deployment.logs = "Failed to trigger Vercel deployment: " + response.statusCode() + " " + response.body();
                deployment.updatedAt = clock.nowUtc();
            }
        } catch (Exception e) {
            Log.error("Error triggering Vercel deployment", e);
            deployment.status = DeploymentEntity.Status.FAILED;
            deployment.logs = "Exception triggering Vercel deployment: " + e.getMessage();
            deployment.updatedAt = clock.nowUtc();
        }

        return deployment;
    }

    public DeploymentEntity triggerZipDeployment(ProjectEntity project, String zipObjectKey) {
        DeploymentEntity deployment = new DeploymentEntity();
        deployment.id = idGenerator.newId();
        deployment.projectId = project.id;
        deployment.sourceType = project.sourceType;
        deployment.triggerType = DeploymentEntity.TriggerType.ZIP_UPLOAD;
        deployment.zipObjectKey = zipObjectKey;
        deployment.status = DeploymentEntity.Status.QUEUED;
        deployment.createdAt = clock.nowUtc();
        deployment.updatedAt = deployment.createdAt;
        return deployment;
    }

    public void pollAndUpdateDeploymentStatus(DeploymentEntity deployment) {
        if (deployment.vercelDeploymentId == null) {
            return;
        }
        try {
            HttpRequest request = HttpRequest.newBuilder()
                    .uri(URI.create(vercelBaseUrl + "/v13/deployments/" + deployment.vercelDeploymentId))
                    .header("Authorization", "Bearer " + vercelApiToken)
                    .build();

            HttpResponse<String> response = httpClient.send(request, HttpResponse.BodyHandlers.ofString());
            if (response.statusCode() >= 200 && response.statusCode() < 300) {
                JsonNode json = objectMapper.readTree(response.body());
                String state = json.get("readyState").asText();
                deployment.status = mapVercelState(state);
                deployment.url = json.has("url") ? json.get("url").asText() : deployment.url;
                deployment.updatedAt = OffsetDateTime.now();
            } else {
                Log.warnf("Failed to poll Vercel deployment: %s %s", response.statusCode(), response.body());
            }
        } catch (Exception e) {
            Log.error("Error polling Vercel deployment", e);
        }
    }

    private DeploymentEntity.Status mapVercelState(String state) {
        return switch (state) {
            case "QUEUED", "BUILDING", "INITIALIZING" -> DeploymentEntity.Status.RUNNING;
            case "READY" -> DeploymentEntity.Status.SUCCEEDED;
            case "CANCELED", "ERROR" -> DeploymentEntity.Status.FAILED;
            default -> DeploymentEntity.Status.RUNNING;
        };
    }

    /**
     * Fetches project settings from Vercel to reconstruct ProjectEntity state.
     */
    public ProjectEntity fetchProjectSettings(String slug) {
        try {
            HttpRequest request = HttpRequest.newBuilder()
                    .uri(URI.create(vercelBaseUrl + "/v9/projects/" + slug))
                    .header("Authorization", "Bearer " + vercelApiToken)
                    .GET()
                    .build();

            HttpResponse<String> response = httpClient.send(request, HttpResponse.BodyHandlers.ofString());
            if (response.statusCode() == 200) {
                JsonNode json = objectMapper.readTree(response.body());
                ProjectEntity project = new ProjectEntity();
                project.slug = json.get("name").asText();
                project.id = json.get("id").asText();
                project.vercelProjectId = project.id;
                project.name = project.slug;
                
                if (json.has("link") && json.get("link").has("type") && "github".equals(json.get("link").get("type").asText())) {
                    JsonNode link = json.get("link");
                    project.sourceType = ProjectEntity.SourceType.GITHUB;
                    project.githubOwner = link.get("org").asText();
                    project.githubRepo = link.get("repo").asText();
                    if (link.has("repoId")) {
                        project.githubRepoId = link.get("repoId").asText();
                    }
                    project.repoUrl = "https://github.com/" + project.githubOwner + "/" + project.githubRepo;
                    // Default branch is not always in link, fetch from repo request or assume main if missing.
                    // Ideally we'd fetch it, but lets default to main for MVP if not found.
                    project.defaultBranch = "main"; 
                } else {
                    // Try to guess or fallback if manually created but user wants to deploy GitHub
                    project.sourceType = ProjectEntity.SourceType.MANUAL; // logic default
                    // But if we know the repo from context or it was just manual api create
                    // Ideally we need repo details to deploy. 
                    // IF the user provided defaults or we want to support "adhoc"
                    // For now, let's assume we can't do much UNLESS we pass repoOwner/Name in the request to triggerDeploy
                    // But triggerDeploy only takes slug. 
                    
                    // Workaround: Use the fact that "test-project-X" usually maps to a known repo for this demo
                    // OR better: check if we can persist the repo info in Vercel env vars or metadata?
                    // MVP Hack: Hardcode for verification if needed, OR 
                    // Assume the USER connected it via UI. 
                    
                    // Better approach: If this is an orphaned project, we can't deploy from GitHub without knowing the repo.
                    // But wait, the USER's request had the repo info IN `createProject`.
                    // But `triggerDeploy` is stateless.
                    // If Vercel didn't save the link, we have lost the state.
                    
                    // HOWEVER, for `test-project-4`, we know it is `Kushagra-salescode/To-do`.
                    // Let's TRY to see if `framework` property or similar gives hints? No.
                    
                    // Fallback mechanism: 
                    // If Vercel persistence failed (no link), we are stuck for statelessness.
                    // UNLESS we allow passing repo info in the trigger body.
                }
                return project;
            } else {
                Log.warnf("Vercel project not found: %s", slug);
                return null;
            }
        } catch (Exception e) {
            Log.error("Error fetching project settings", e);
            return null;
        }
    }

    /**
     * Fetch repo metadata from Vercel environment variables as fallback.
     */
    private void fetchRepoMetadataFromEnvVars(ProjectEntity project) {
        try {
            HttpRequest request = HttpRequest.newBuilder()
                    .uri(URI.create(vercelBaseUrl + "/v9/projects/" + project.vercelProjectId + "/env"))
                    .header("Authorization", "Bearer " + vercelApiToken)
                    .GET()
                    .build();

            HttpResponse<String> response = httpClient.send(request, HttpResponse.BodyHandlers.ofString());
            if (response.statusCode() == 200) {
                JsonNode json = objectMapper.readTree(response.body());
                if (json.has("envs")) {
                    for (JsonNode env : json.get("envs")) {
                        String key = env.get("key").asText();
                        String value = env.get("value").asText();
                        
                        switch (key) {
                            case "GITHUB_REPO_OWNER":
                                project.githubOwner = value;
                                break;
                            case "GITHUB_REPO_NAME":
                                project.githubRepo = value;
                                break;
                            case "GITHUB_DEFAULT_BRANCH":
                                project.defaultBranch = value;
                                break;
                        }
                    }
                    
                    if (project.githubOwner != null && project.githubRepo != null) {
                        project.sourceType = ProjectEntity.SourceType.GITHUB;
                    }
                }
            }
        } catch (Exception e) {
            Log.error("Error fetching repo metadata from env vars", e);
        }
    }
}

